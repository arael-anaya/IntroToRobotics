<?xml version="1.0" ?>
<robot name="my_robot">
  <material name="blue">
    <color rgba="0.1 0.4 0.9 1"/>
  </material>
  <material name="wood">
    <color rgba="0.4 0.25 0.12 1"/>
  </material>
  <material name="gray">
    <color rgba="0.35 0.35 0.35 1"/>
  </material>
  <material name="red">
    <color rgba="0.9 0.3 0.1 1"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>
  <material name="black">
    <color rgba="0.05 0.05 0.05 1"/>
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <!-- Table top -->
    <visual name="table_top">
      <origin xyz="0 0 0.6375" rpy="0 0 0"/>
      <geometry><box size="2.55 1.95 0.15"/></geometry>
      <material name="wood"/>
    </visual>
    <!-- Table legs (ground is at z = -0.5625) -->
    <visual name="leg_fl">
      <origin xyz="1.05 0.6375 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 1.125"/></geometry>
      <material name="gray"/>
    </visual>
    <visual name="leg_fr">
      <origin xyz="1.05 -0.6375 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 1.125"/></geometry>
      <material name="gray"/>
    </visual>
    <visual name="leg_bl">
      <origin xyz="-1.05 0.6375 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 1.125"/></geometry>
      <material name="gray"/>
    </visual>
    <visual name="leg_br">
      <origin xyz="-1.05 -0.6375 0" rpy="0 0 0"/>
      <geometry><box size="0.15 0.15 1.125"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.25 1.5 0.45"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="9.0"/>
      <inertia ixx="1.839375" ixy="0" ixz="0" iyy="3.94875" iyz="0" izz="5.484375"/>
    </inertial>
  </link>

  <!-- Front Left Wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="1.05 0.6375 -0.5625" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_left_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.025"/>
      <inertia ixx="0.0000119" ixy="0" ixz="0" iyy="0.0000119" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Front Right Wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="1.05 -0.6375 -0.5625" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_right_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.025"/>
      <inertia ixx="0.0000119" ixy="0" ixz="0" iyy="0.0000119" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Back Left Wheel -->
  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_left_wheel"/>
    <origin xyz="-1.05 0.6375 -0.5625" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="back_left_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.025"/>
      <inertia ixx="0.0000119" ixy="0" ixz="0" iyy="0.0000119" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Back Right Wheel -->
  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_right_wheel"/>
    <origin xyz="-1.05 -0.6375 -0.5625" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="back_right_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.04"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.025"/>
      <inertia ixx="0.0000119" ixy="0" ixz="0" iyy="0.0000119" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <!-- Lidar -->
  <joint name="lidar_joint" type="fixed">
    <parent link="base_link"/>
    <child link="lidar_link"/>
    <origin xyz="0.6 0 0.8625" rpy="0 0 0"/>
  </joint>

  <link name="lidar_link">
    <visual>
      <geometry><cylinder radius="0.1875" length="0.3"/></geometry>
      <material name="red"/>
    </visual>
    <collision>
      <geometry><cylinder radius="0.1875" length="0.3"/></geometry>
    </collision>
    <inertial>
      <mass value="1.5"/>
      <inertia ixx="0.024434" ixy="0" ixz="0" iyy="0.024434" iyz="0" izz="0.026367"/>
    </inertial>
  </link>

  <!-- Keep lidar_link its own link so the scan frame_id matches the TF frame -->
  <gazebo reference="lidar_joint">
    <disableFixedJointLumping>true</disableFixedJointLumping>
  </gazebo>

  <gazebo reference="lidar_link">
    <sensor name="lidar" type="gpu_lidar">
      <topic>scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <!-- Drawing the rays is expensive without a GPU; see the scan in RViz instead -->
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>360</samples>
            <min_angle>-3.14159</min_angle>
            <max_angle>3.14159</max_angle>
          </horizontal>
        </scan>
        <range>
          <min>0.08</min>
          <max>10.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- Wheel friction: high mu plus stiff contact so the wheels grip instead of
       skating once they're spun fast by the diff-drive plugin -->
  <gazebo reference="front_left_wheel"><mu1>3.0</mu1><mu2>3.0</mu2><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>
  <gazebo reference="front_right_wheel"><mu1>3.0</mu1><mu2>3.0</mu2><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>
  <gazebo reference="back_left_wheel"><mu1>3.0</mu1><mu2>3.0</mu2><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>
  <gazebo reference="back_right_wheel"><mu1>3.0</mu1><mu2>3.0</mu2><kp>1000000.0</kp><kd>1.0</kd><minDepth>0.001</minDepth></gazebo>

  <!-- Differential drive: two joints per side -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>1.275</wheel_separation>
      <wheel_radius>0.04</wheel_radius>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>
</robot>
