<?xml version="1.0" ?>
<robot name="my_robot">
  <material name="blue">
    <color rgba="0.1 0.4 0.9 1"/>
  </material>
  <material name="wood">
    <color rgba="0.4 0.25 0.12 1"/>
  </material>
  <material name="gray">
    <color rgba="0.35 0.35 0.35 1"/>
  </material>
  <material name="white">
    <color rgba="0.9 0.9 0.9 1"/>
  </material>

  <!-- Base Link -->
  <link name="base_link">
    <!-- Table top -->
    <visual name="table_top">
      <origin xyz="0 0 0.05" rpy="0 0 0"/>
      <geometry><box size="0.34 0.26 0.02"/></geometry>
      <material name="wood"/>
    </visual>
    <!-- Table legs (ground is at z = -0.05) -->
    <visual name="leg_fl">
      <origin xyz="0.14 0.085 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <material name="gray"/>
    </visual>
    <visual name="leg_fr">
      <origin xyz="0.14 -0.085 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <material name="gray"/>
    </visual>
    <visual name="leg_bl">
      <origin xyz="-0.14 0.085 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <material name="gray"/>
    </visual>
    <visual name="leg_br">
      <origin xyz="-0.14 -0.085 0" rpy="0 0 0"/>
      <geometry><box size="0.02 0.02 0.1"/></geometry>
      <material name="gray"/>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.2 0.06"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="2.0"/>
      <inertia ixx="0.0069" ixy="0" ixz="0" iyy="0.0158" iyz="0" izz="0.0217"/>
    </inertial>
  </link>

  <!-- Front Left Wheel -->
  <joint name="front_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_left_wheel"/>
    <origin xyz="0.1 0.115 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_left_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Front Right Wheel -->
  <joint name="front_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="front_right_wheel"/>
    <origin xyz="0.1 -0.115 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="front_right_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Back Left Wheel -->
  <joint name="back_left_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_left_wheel"/>
    <origin xyz="-0.1 0.115 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="back_left_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Back Right Wheel -->
  <joint name="back_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="back_right_wheel"/>
    <origin xyz="-0.1 -0.115 0" rpy="-1.5708 0 0"/>
    <axis xyz="0 0 1"/>
  </joint>

  <link name="back_right_wheel">
    <collision>
      <geometry>
        <cylinder length="0.03" radius="0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.2"/>
      <inertia ixx="0.00013" ixy="0" ixz="0" iyy="0.00013" iyz="0" izz="0.00025"/>
    </inertial>
  </link>

  <!-- Wheel friction -->
  <gazebo reference="front_left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="front_right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="back_left_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>
  <gazebo reference="back_right_wheel"><mu1>1.0</mu1><mu2>1.0</mu2></gazebo>

  <!-- Differential drive: two joints per side -->
  <gazebo>
    <plugin filename="ignition-gazebo-diff-drive-system" name="ignition::gazebo::systems::DiffDrive">
      <left_joint>front_left_wheel_joint</left_joint>
      <left_joint>back_left_wheel_joint</left_joint>
      <right_joint>front_right_wheel_joint</right_joint>
      <right_joint>back_right_wheel_joint</right_joint>
      <wheel_separation>0.23</wheel_separation>
      <wheel_radius>0.05</wheel_radius>
      <topic>cmd_vel</topic>
    </plugin>
  </gazebo>
</robot>
